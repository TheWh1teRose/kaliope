# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Persistent data root (database, uploads, artifacts, renders).
DATA_DIR=/data
# SQLite journal mode. Local default WAL. The container image sets DELETE
# for network or bucket mounts (Cloud Run).
SQLITE_JOURNAL_MODE=WAL
# At least one provider key is required to call an LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# ElevenLabs key for the audio pipelines (speech synthesis). Optional; without
# it audio can be prepared and priced but not generated. On Cloud Run it comes
# from the Secret Manager secret elevenlabs-api-key.
ELEVENLABS_API_KEY=
# Model used when a pipeline node does not set its own.
DEFAULT_MODEL=claude-opus-4-6
# Cheap fast model for zone classification; empty uses the registry default.
ZONE_MODEL=
# How many pipeline runs may execute at once.
MAX_CONCURRENT_RUNS=2
# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
# Session cookie lifetime in days.
SESSION_TTL_DAYS=30
# Maximum PDF upload size in megabytes.
MAX_UPLOAD_MB=50
